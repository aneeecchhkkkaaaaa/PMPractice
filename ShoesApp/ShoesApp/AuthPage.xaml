<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShoesApp.AuthPage"
             Title="AuthPage">
    
    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" 
                         Spacing="15" 
                         WidthRequest="320" 
                         Padding="20">

        <!-- Заголовок страницы -->
        <Label Text="Авторизация" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               Margin="0,0,0,10"/>

        <!-- Поле ввода Логина -->
        <Entry Placeholder="Логин или Email" 
               Keyboard="Email"
               ClearButtonVisibility="WhileEditing"/>

        <!-- Поле ввода Пароля -->
        <Entry Placeholder="Пароль" 
               IsPassword="True"
               ClearButtonVisibility="WhileEditing"/>

        <!-- Кнопка Войти -->
        <Button Text="Войти" 
                FontAttributes="Bold"
                Margin="0,10,0,0"/>

        <!-- Кнопка Войти как гость -->
        <Button Text="Войти как гость" 
                BorderWidth="1"/>

    </VerticalStackLayout>
</ContentPage>